{erl_opts, [debug_info]}.
{minimum_otp_vsn, "27"}.

{dialyzer, [{warnings, [no_contracts, no_opaque]}]}.

{deps, [
    {herrie, "1.0.0"}
]}.

{shell, [{apps, [noisegate]}]}.

{escript_name, noisegate_guests}.
{escript_main_app, noisegate}.
{escript_incl_apps, []}.
{escript_emu_args, "%%! -escript main\n"}.
